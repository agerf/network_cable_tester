# Master: ESP32-S3, WLAN-Access-Point, Web-UI, Test-Steuerung (Node A).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_CABLE_TESTER_ROLE_MASTER=y
# CONFIG_CABLE_TESTER_ROLE_SLAVE is not set

# LVGL display UI (master only)
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_BUTTON=y
CONFIG_LV_USE_LINE=y
CONFIG_LV_USE_TABLE=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_CLIB_MALLOC=y
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
